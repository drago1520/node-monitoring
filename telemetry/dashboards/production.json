          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "aggregations": [
                      {
                        "expression": "p95(duration_nano)"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name = 'hono' AND kind_string = 'Server'"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "p95(duration_nano)",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
