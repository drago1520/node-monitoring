{
  "spec": {
    "display": {
      "name": "Hono — Overview",
      "description": "CPU, RSS memory, incoming request rate, p95 and p99 server response time, and errors for the hono service."
    },
    "variables": [],
    "panels": {
      "cpu": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "CPU",
            "description": "Hono cpu."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "percentunit",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "process.cpu.utilization",
                        "temporality": "unspecified",
                        "timeAggregation": "avg",
                        "spaceAggregation": "sum"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name = 'hono'"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "__result",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "limit": 100,
                    "legend": "CPU"
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Errors / sec",
            "description": "Errored incoming requests per second; empty when no errors have been recorded."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "reqps",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "traces",
                    "source": "",
                    "aggregations": [
                      {
                        "expression": "rate()"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name = 'hono' AND kind_string = 'Server' AND has_error = true"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "rate()",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "limit": 100,
                    "legend": "Errors / sec"
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "event-loop-delay": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Event-loop delay (p99)",
            "description": "Closest available proxy for Node request-handling saturation: event-loop delay shows how late scheduled work runs. Rising delay can indicate a busy or blocked main thread delaying request handling. This is not an HTTP queue length or a measure of time waiting on databases/external APIs. Compare against the idle baseline and CPU. Shows the maximum reported p99 delay per chart interval across hono processes.\n\nThink: “How quickly can Node pick up the next piece of work?”"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": {
                "timePreference": "global_time",
                "fillSpans": false
              },
              "formatting": {
                "unit": "s",
                "decimalPrecision": "2"
              },
              "chartAppearance": {
                "lineInterpolation": "linear",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": {
                  "fillOnlyBelow": false,
                  "fillLessThan": ""
                }
              },
              "axes": {
                "softMin": null,
                "softMax": null,
                "isLogScale": false
              },
              "legend": {
                "position": "bottom",
                "mode": "list",
                "customColors": null
              },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [
                      {
                        "metricName": "nodejs.eventloop.delay.p99",
                        "temporality": "unspecified",
                        "timeAggregation": "max",
                        "spaceAggregation": "max"
                      }
                    ],
                    "disabled": false,
                    "filter": {
                      "expression": "service.name = 'hono'"
                    },
                    "order": [
                      {
                        "key": {
                          "name": "__result",
                          "signal": "",
                          "fieldContext": "",
                          "fieldDataType": ""
                        },
                        "direction": "desc"
                      }
                    ],
                    "limit": 100,
                    "legend": "Event-loop delay (p99)"
                  }
                }
              }
            }
          ],
          "links": null
        }
      },
      "latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Server response time (p95)",
            "description": "p95 duration of incoming Hono HTTP server spans, from request receipt until the server finishes its response. Includes awaited database and API calls; excludes the client's network round trip and response parsing."
